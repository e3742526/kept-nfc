---
import light from '../../../web/src/assets/sheepkeep-horizontal-evergreen.svg';
import dark from '../../../web/src/assets/sheepkeep-horizontal-ivory.svg';
import { langOf, pick } from '../i18n';
import { siteSub } from '../words';

const { siteTitle, siteTitleHref, lang } = Astro.locals.starlightRoute;
const sub = pick(siteSub, langOf(lang));
---

<a href={siteTitleHref} class="site-title kd-site-title" aria-label={siteTitle} translate="no">
  <img class="kd-brand-light" src={light.src} width="120" height="31" alt="" />
  <img class="kd-brand-dark" src={dark.src} width="120" height="31" alt="" />
  <span class="kd-site-sub">{sub}</span>
</a>

<style>
  .kd-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    min-width: 0;
  }
  .kd-site-title img {
    display: block;
    flex-shrink: 0;
    direction: ltr;
  }
  .kd-site-title .kd-brand-dark,
  :global(:root[data-theme='dark']) .kd-site-title .kd-brand-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .kd-site-title .kd-brand-dark {
    display: block;
  }
  .kd-site-sub {
    font: 500 0.875rem / 1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--ink-3);
    padding-inline-start: 0.625rem;
    border-inline-start: 1px solid var(--line);
  }
  :global(:root:lang(ar)) .kd-site-sub {
    font-family: var(--arabic);
    letter-spacing: 0;
  }
  @media (max-width: 30rem) {
    .kd-site-sub {
      display: none;
    }
  }
</style>
